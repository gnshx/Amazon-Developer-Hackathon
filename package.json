{
  "name": "warrant-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Warrant: A Trust Gateway for Voice Agents (Amazon Developer Hackathon, Alexa+ Track)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "prepare": "npm --workspace=@warrant/gateway run build && npm --workspace=@warrant/siege run build",
    "test": "npm run --workspaces --if-present test && tsx scripts/check-claims.ts",
    "test:siege": "npm --workspace=packages/warrant-siege run test:siege",
    "test:mutation": "tsx scripts/test-mutation.ts",
    "test:bedrock": "tsx scripts/test-bedrock-live.ts",
    "check:bedrock-models": "tsx scripts/check-bedrock-models.ts",
    "audit:verify": "tsx packages/warrant-gateway/scripts/verify-audit.ts",
    "receipt:verify": "tsx packages/warrant-gateway/scripts/verify-receipt.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "test:skill": "tsx scripts/test-agent-skill.ts",
    "test:demo-flow": "tsx scripts/run-live-demo-flow.ts",
    "test:latency": "tsx scripts/test-latency.ts",
    "test:compare": "tsx scripts/test-naive-comparison.ts",
    "check:alexa-tooling": "tsx scripts/check-alexa-tooling.ts",
    "check:claims": "tsx scripts/check-claims.ts",
    "dev": "npm run --workspaces --parallel --if-present dev",
    "lint": "npm run --workspaces --if-present lint"
  },
  "keywords": [
    "alexa",
    "voice-agents",
    "mcp",
    "amazon-bedrock",
    "safety-gateway",
    "saga-orchestrator",
    "idempotency",
    "audit-chain"
  ],
  "author": "Warrant Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1152.0"
  }
}
